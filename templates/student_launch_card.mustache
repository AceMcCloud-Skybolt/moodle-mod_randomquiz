{{!
    @template mod_randomquiz/student_launch_card

    Student entry point for a random quiz allocation.

    Context variables required for this template:
    * title - Card heading.
    * intro - Explanation of the allocation workflow.
    * lockedmessage - Notice that the allocation remains stable.
    * buttonlabel - Launch button label.
    * actionurl - Form action URL.
    * sesskey - Moodle session key.

    Example context (json):
    {
        "title": "Your quiz is ready.",
        "intro": "Your quiz will be selected when you start.",
        "lockedmessage": "Your allocation will stay the same.",
        "buttonlabel": "Start quiz",
        "actionurl": "https://example.test/mod/randomquiz/view.php?id=42&action=startquiz",
        "sesskey": "example"
    }
}}
<div class="container-fluid p-0">
    <div class="border rounded p-4 bg-light">
        <h3 class="mb-3">{{title}}</h3>
        <p class="mb-3">{{intro}}</p>
        <p class="text-muted">{{lockedmessage}}</p>
        <form action="{{actionurl}}" method="post" class="mb-0">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <button type="submit" class="btn btn-primary">{{buttonlabel}}</button>
        </form>
    </div>
</div>
