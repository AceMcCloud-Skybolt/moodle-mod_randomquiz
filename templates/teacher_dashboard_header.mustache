{{!
    @template mod_randomquiz/teacher_dashboard_header

    Introduction and status badges for the teacher dashboard.

    Context variables required for this template:
    * pluginname - Activity plugin name.
    * title - Dashboard heading.
    * intro - Dashboard explanation.
    * allocationmode - Configured allocation mode label.
    * lockslabel - Allocation locking badge label.
    * quizzeslabel - Moodle quiz badge label.
    * gradebooklabel - Gradebook configuration badge label.

    Example context (json):
    {
        "pluginname": "Random quiz allocator",
        "title": "Variant readiness dashboard",
        "intro": "Students see this one activity.",
        "allocationmode": "Balanced random",
        "lockslabel": "Locks when started",
        "quizzeslabel": "Uses normal Moodle quizzes",
        "gradebooklabel": "Gradebook: highest grade category"
    }
}}
<div class="container-fluid p-0">
    <div class="p-4 mb-4 border rounded bg-light">
        <p class="text-uppercase text-muted small mb-1">{{pluginname}}</p>
        <h3 class="mb-2">{{title}}</h3>
        <p class="mb-3">{{intro}}</p>
        <div class="d-flex flex-wrap gap-2">
            <span class="badge rounded-pill text-bg-primary">{{allocationmode}}</span>
            <span class="badge rounded-pill text-bg-secondary">{{lockslabel}}</span>
            <span class="badge rounded-pill text-bg-secondary">{{quizzeslabel}}</span>
            <span class="badge rounded-pill text-bg-secondary">{{gradebooklabel}}</span>
        </div>
    </div>
</div>
